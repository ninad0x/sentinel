generator client {
  provider = "prisma-client-js"
  // output   = "../generated/prisma"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model User {
  id             String    @id @default(cuid())
  name           String
  email          String    @unique
  emailVerified  Boolean   @default(false)
  image          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  sessions       Session[]
  accounts       Account[]
  websites       Website[]
}

model Session {
  id         String    @id @default(cuid())
  userId     String
  token      String    @unique
  expiresAt  DateTime
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([accountId, providerId])
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([identifier, value])
}


model Website {
  id            String      @id @default(cuid())
  url           String
  name          String
  userId        String
  timeAdded     DateTime    @default(now())

  enabled       Boolean     @default(true)
  currentStatus Int
  lastChecked   DateTime?

  ticks         WebsiteTick[]
  metric        WebsiteMetric[]
  incidents     Incident[]
  user          User        @relation(fields: [userId], references: [id])
}

model Incident {
  id          String        @id @default(cuid())
  websiteId   String
  startedAt   DateTime      @default(now())
  endedAt     DateTime?
  status      String
  type        IncidentType  @default(Global)
  cause       String?

  website     Website       @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  // "Only one open incident per site" is a partial unique index, which Prisma
  // can't express. Add it by hand in the migration SQL:
  //   CREATE UNIQUE INDEX one_open_incident_per_site
  //     ON "Incident" ("websiteId") WHERE "endedAt" IS NULL;
  @@index([websiteId, startedAt])
}

enum IncidentType {
  Global
  Regional
}

model Region {
  id     String        @id @default(cuid())
  name   String        @unique
  ticks  WebsiteTick[]
}

model WebsiteTick {
  id              String   @default(cuid())
  createdAt       DateTime @default(now()) @db.Timestamptz()  // actual ping
  roundAt         DateTime @db.Timestamptz()
  responseTimeMs  Int?
  status          Int
  regionId        String
  websiteId       String
  details         String?

  region          Region   @relation(fields: [regionId], references: [id])
  website         Website  @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@id([id, createdAt])
  @@unique([websiteId, regionId, roundAt])
  @@index([websiteId, createdAt])
  @@index([roundAt])
}

// Hourly rollup. Aite * region per hour,
// plus one row with regionId = "ALL" that pools every region (for site-wide p95/p99).
model WebsiteMetric {
  id                 String   @default(cuid())
  websiteId          String
  regionId           String   @default("ALL")
  windowStart        DateTime @db.Timestamptz()

  checks             Int
  failures           Int
  uptimePercent      Float
  avgResponseTimeMs  Int?
  minMs              Int?
  maxMs              Int?
  p50Ms              Int?
  p95Ms              Int?
  p99Ms              Int?

  createdAt          DateTime @default(now())

  website            Website  @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@id([id, windowStart])
  @@unique([websiteId, regionId, windowStart])
  @@index([websiteId, windowStart])
}
