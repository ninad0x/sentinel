
generator client {
  provider = "prisma-client-js"
  // output   = "../generated/prisma"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model User {
  id             String    @id @default(cuid())
  name           String
  email          String    @unique
  emailVerified  Boolean   @default(false)
  image          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  sessions       Session[]
  accounts       Account[]
  websites       Website[]
  
}

model Session {
  id         String    @id @default(cuid())
  userId     String
  token      String    @unique
  expiresAt  DateTime
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                   String    @id @default(cuid())
  userId               String
  accountId            String
  providerId           String
  accessToken          String?
  refreshToken         String?
  accessTokenExpiresAt DateTime?
  refreshTokenExpiresAt DateTime?
  scope                String?
  idToken              String?
  password             String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([accountId, providerId])
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([identifier, value])
}


model Website {
  id          String      @id    @default(cuid())
  url         String
  name        String
  userId      String
  timeAdded   DateTime    @default(now())

  enabled        Boolean     @default(true)
  currentStatus   Int     
  lastChecked     DateTime?

  ticks       WebsiteTick[]
  metric      WebsiteMetric[]
  incidents   Incident[]
  user        User       @relation(fields: [userId], references: [id])
}

model Incident {
  id          String    @id @default(cuid())
  websiteId   String
  startedAt   DateTime  @default(now())
  endedAt     DateTime?
  status      String
  type        IncidentType    @default(Global)
  cause       String? 
  
  website     Website   @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  @@unique([websiteId, endedAt])
}

enum IncidentType {
  Global  
  Regional
}

model Region {
  id          String    @id     @default(cuid())
  name        String
  ticks       WebsiteTick[]

}

model WebsiteTick {
  id                    String    @default(cuid())
  createdAt             DateTime    @default(now()) @db.Timestamptz()
  responseTimeMs        Int
  status                Int
  regionId              String
  websiteId             String  
  details               String?
  region                Region  @relation(fields: [regionId], references: [id])
  website               Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@id([id, createdAt])
  @@index([websiteId, createdAt])
}

model WebsiteMetric {
  id                    String    @default(cuid())

  websiteId            String
  windowStart          DateTime  @db.Timestamptz()
  windowEnd            DateTime

  finalStatus          Int
  uptimePercent        Float
  avgResponseTimeMs    Int?

  regionsDownCount    Int
  regionsDownList     String[]

  createdAt            DateTime   @default(now())

  website               Website    @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@id([id, windowStart])
  @@index([websiteId, windowStart])
}

